  "narrative": {
    "northStar": "Der gedeckte Tisch",
    "overview": "Große, echte Fotos und Videos tragen jede Seite. Der Grund ist warmer Sand, der Text ist kurz und gastfreundlich, und der Topf ist der Star. Die Seite ist ein Brand-Book-Ableger (Brand Book 2026, vom Nutzer gepinnt): Farben und Schriften sind Vorgabe, nicht Geschmack. Das System ist flach und linienbasiert; Gold ist eine Fläche, nie ein Textton auf Sand.",
    "keyCharacteristics": [
      "Sand als Grund (etwa 70 %), Tinte für Bänder (Rezensionen, Mobilmenü, Footer)",
      "Caprasimo nur für die H1 jeder Seite, Figtree für alles andere",
      "20px-Radius für Fotos und Bänder, Pillen für Buttons, Chips und Tags",
      "1px-Linien in Tinte oder 18 % Tinte statt Schatten",
      "Echte Fotos in 4:3, 4:5, 9:16; keine Muster als Layout-Dekor"
    ],
    "rules": [
      {
        "name": "The Gold-Is-A-Surface Rule",
        "body": "Gold (#FEB34E) füllt Flächen oder unterstreicht als Balken. Auf Sand ist Text-Gold immer Gold dunkel.",
        "section": "colors"
      },
      {
        "name": "The Ink-Band Rule",
        "body": "Dunkle Bänder sind Tinte, nie Schwarz oder Braun, und sie tragen Sand-Text.",
        "section": "colors"
      },
      {
        "name": "The One Caprasimo Rule",
        "body": "Caprasimo steht nur auf der H1. Alle anderen Überschriften sind Figtree 700.",
        "section": "typography"
      },
      {
        "name": "The Meta-Only Label Rule",
        "body": "Das Label-Format kennzeichnet Datum, Kategorie oder Credit. Es sitzt nicht als Kicker über einer Überschrift.",
        "section": "typography"
      },
      {
        "name": "The Line-Not-Shadow Rule",
        "body": "Trennung durch 1px-Linien (Tinte oder 18 % Tinte). Kein weiterer Schatten, kein Hard-Offset.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do Sand als Grund und Tinte als Band nutzen; Gold nur als Fläche oder Balken.",
      "Do Text-Gold auf Sand immer als Gold dunkel (#8F5716) setzen.",
      "Do Caprasimo nur für die H1 verwenden, den Rest in Figtree.",
      "Do echte Fotos und Videos in festen Seitenverhältnissen mit 20px (oder 12px im Raster) Radius zeigen.",
      "Do Trennung durch 1px-Linien lösen und Buttons als Pillen mit mindestens 52px Höhe bauen.",
      "Do Fotos von Naomi Hattler mit \"Foto: Naomi Hattler\" kennzeichnen."
    ],
    "donts": [
      "Don't Gold als Textfarbe auf Sand verwenden.",
      "Don't Wax- oder Ankara-Muster als Layout-Dekor einsetzen; sie gehören nur ins Foto.",
      "Don't ein Raster gleich großer Icon-Karten, Stock- oder KI-Bilder bauen.",
      "Don't Schatten zur Trennung nutzen (nur der WhatsApp-Button hat einen).",
      "Don't das Logo auf unruhigen Bildbereichen platzieren."
    ]
  }
